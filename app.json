{
  "expo": {
    "name": "WttM",
    "slug": "WttM",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/android/icon-1024.png",
    "scheme": "wttmreact",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/ios/icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c111c",
        "foregroundImage": "./assets/icons/android/icon-1024a.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "splash": {
      "image": "./assets/icons/android/icon-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c111c"
    },
    "web": {
      "name": "WttM",
      "output": "static",
      "favicon": "./assets/icons/android/icon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
